# Application
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (used by docker-compose postgres service)
# Choose your own password; Compose refuses to start if it is empty.
POSTGRES_USER=acf
POSTGRES_PASSWORD=change_me
POSTGRES_DB=acf

# SQLAlchemy async URL (asyncpg). Must match the POSTGRES_* values above.
# Inside Docker Compose network, host is `postgres`.
# From the host machine (local pytest against published port), use localhost.
DATABASE_URL=postgresql+asyncpg://acf:change_me@postgres:5432/acf

# Optional. Tests truncate tables, so they run against a separate database and
# by default use DATABASE_URL with an `_test` suffix (acf -> acf_test).
TEST_DATABASE_URL=

# OpenAI (used by OpenAIWriter — never commit real secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible endpoint. Leave empty for the official API.
# OpenRouter example: https://openrouter.ai/api/v1 with OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=

# Generation tuning
OPENAI_TEMPERATURE=0.4
# Must comfortably exceed ARTICLE_TARGET_WORD_COUNT; Russian markdown costs
# roughly 2.5-3 tokens per word.
OPENAI_MAX_TOKENS=16000
ARTICLE_TARGET_WORD_COUNT=3000

# Short drafts are sent back for expansion until they reach
# ARTICLE_MIN_WORD_RATIO * ARTICLE_TARGET_WORD_COUNT.
# Each attempt is one extra provider call; 0 attempts disables expansion.
ARTICLE_MIN_WORD_RATIO=0.8
ARTICLE_EXPAND_ATTEMPTS=2

# Directory with prompt files. Leave empty to use ./prompts next to the project.
PROMPTS_DIR=

# Completed articles are also saved as Markdown files. Empty disables file output.
ARTICLES_OUTPUT_DIR=output/articles

# n8n (Compose service — UI only; no OpenAI / DB secrets here)
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Moscow
