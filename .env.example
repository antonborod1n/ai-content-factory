# Application
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
# Empty = INFO (WARNING when APP_ENV=test). One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Browser origins for the Stage 8a operator UI (Vite). Comma-separated.
# Empty disables CORS. Dev defaults match Vite (see web/vite.config.ts).
APP_CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# PostgreSQL (used by docker-compose postgres service)
# Choose your own password; Compose refuses to start if it is empty.
POSTGRES_USER=acf
POSTGRES_PASSWORD=change_me
POSTGRES_DB=acf

# SQLAlchemy async URL (asyncpg). Must match the POSTGRES_* values above.
# Inside Docker Compose network, host is `postgres`.
# From the host machine (local pytest against published port), use localhost.
DATABASE_URL=postgresql+asyncpg://acf:change_me@postgres:5432/acf

# Optional. Tests truncate tables, so they run against a separate database and
# by default use DATABASE_URL with an `_test` suffix (acf -> acf_test).
TEST_DATABASE_URL=

# OpenAI (used by OpenAIWriter — never commit real secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible endpoint. Leave empty for the official API.
# OpenRouter example: https://openrouter.ai/api/v1 with OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=

# Generation tuning
OPENAI_TEMPERATURE=0.4
# Seconds for one model call. One retry, then the job is marked failed.
OPENAI_TIMEOUT_SECONDS=300
# Must comfortably exceed ARTICLE_TARGET_WORD_COUNT; Russian markdown costs
# roughly 2.5-3 tokens per word.
OPENAI_MAX_TOKENS=16000
ARTICLE_TARGET_WORD_COUNT=3000

# Short drafts are sent back for expansion until they reach
# ARTICLE_MIN_WORD_RATIO * ARTICLE_TARGET_WORD_COUNT. With an outline the
# check runs per section against its share of the target.
# Each attempt is one extra provider call; 0 attempts disables expansion.
ARTICLE_MIN_WORD_RATIO=0.8
ARTICLE_EXPAND_ATTEMPTS=2

# Directory with prompt files. Leave empty to use ./prompts next to the project.
PROMPTS_DIR=

# Completed articles are also saved as Markdown files. Empty disables file output.
ARTICLES_OUTPUT_DIR=output/articles

# JSONL journal of article, image, and competitor runs. Empty disables the file.
RUNS_LOG_PATH=logs/runs.jsonl

# Largest accepted upload per file (knowledge base, competitor dumps), in MB.
MAX_UPLOAD_MB=20

# Stage 2 — Knowledge Base / RAG. Embeddings use OPENAI_API_KEY / OPENAI_BASE_URL.
# The vector column is 1536-d (text-embedding-3-small). Changing dimensions
# requires a new migration.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_ENABLED=true
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_FILE_BYTES=2000000

# Stage 3 — competitor SERP research (Serper). Leave SERP_API_KEY empty to
# skip live search; generate still works without use_competitor_research.
SERP_PROVIDER=serper
SERP_API_KEY=
SERP_BASE_URL=https://google.serper.dev/search
RESEARCH_ENABLED=true
RESEARCH_TOP_N=10
# Extra organic hits before the article filter (YouTube / shops / short pages).
RESEARCH_SEARCH_N=40
RESEARCH_MIN_ARTICLE_CHARS=300
RESEARCH_FETCH_TIMEOUT_SECONDS=15
RESEARCH_MAX_PAGE_BYTES=1000000
RESEARCH_USER_AGENT=AI-Content-Factory/0.1 (+research)

# Topic Discovery — Google (SERP_API_KEY / Serper) + Yandex (SerpAPI).
# Missing YANDEX_SERP_API_KEY skips Yandex; missing SERP_API_KEY fails discovery.
DISCOVERY_ENABLED=true
DISCOVERY_MAX_TOPICS=10
DISCOVERY_SEARCH_N=20
YANDEX_SERP_PROVIDER=serpapi
YANDEX_SERP_API_KEY=
YANDEX_SERP_BASE_URL=https://serpapi.com/search
TOPICS_FILE_PATH=topics/topics.json
COMPETITOR_TOPICS_ENABLED=true
COMPETITOR_TOPICS_MAX_TOPICS=80
COMPETITOR_TOPICS_MAX_HITS=400

# Stage 4 — multi-agent generate (off per request unless use_multi_agent=true).
MULTI_AGENT_ENABLED=true

# Stage 5 — real images (opt-in per request: use_images) and internal links.
# Images use the same OPENAI_API_KEY. OpenRouter: x-ai/grok-imagine-image-2.0.
IMAGES_ENABLED=true
OPENAI_IMAGE_MODEL=x-ai/grok-imagine-image-2.0
OPENAI_IMAGE_SIZE=1792x1024
INTERNAL_LINKS_ENABLED=true
INTERNAL_LINK_MAX=5
INTERNAL_LINK_PREFIX=/

# Stage 6 — shorter Dzen version. Per-topic: use_dzen in topics.json / generate.
# This flag is the global switch: false skips Dzen even if use_dzen=true.
DZEN_ENABLED=true
DZEN_TARGET_CHAR_COUNT=4000

# Stage 6 quality — detectors / humanizer / summary (off per request).
# Heuristic chat scores, not Copyscape / GPTZero / Humanizer SaaS.
QUALITY_ENABLED=true
DETECTOR_AI_REVIEW_THRESHOLD=70
DETECTOR_UNIQUENESS_FLOOR=50
SUMMARY_TARGET_CHAR_COUNT=500

# n8n (Compose service — UI only; no OpenAI / DB secrets here)
# Host port of the n8n UI; inside the container n8n always listens on 5678.
N8N_PORT=15678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:15678/
GENERIC_TIMEZONE=Europe/Moscow
